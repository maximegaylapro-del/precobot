# ====== NOTIFICATIONS ======
# URL du webhook Discord (Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxx/yyyyy

# Notifications email (optionnel) — laisser vide pour désactiver
EMAIL_ENABLED=false
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=ton.email@gmail.com
EMAIL_SMTP_PASS=mot_de_passe_application
EMAIL_FROM=ton.email@gmail.com
EMAIL_TO=destinataire@example.com

# ====== SCRAPING ======
# Fréquence de scan en secondes (minimum conseillé : 60)
SCAN_INTERVAL_SECONDS=180

# Plages horaires actives (format HH:MM-HH:MM, séparées par virgules).
# Laisser vide pour scanner 24h/24. Les scans manuels ignorent cette restriction.
# Exemple : SCAN_ACTIVE_HOURS=08:00-22:00  ou  08:00-12:00,14:00-22:00
SCAN_ACTIVE_HOURS=08:00-22:00

# Mode headless (true/false) — false = voir le navigateur (debug)
HEADLESS=true

# Nombre max de scrapers en parallèle
MAX_CONCURRENT_SCRAPERS=2

# Timeout par requête en ms
REQUEST_TIMEOUT_MS=30000

# ====== FILTRES ======
# Mots-clés pour détecter les précommandes (séparés par virgules)
PREORDER_KEYWORDS=précommande,preorder,pre-order,pré-commande,à paraître,à venir,sortie prévue,available soon

# Mots-clés pour identifier One Piece TCG (séparés par virgules)
ONEPIECE_KEYWORDS=one piece card game,one piece tcg,op-,op01,op02,op03,op04,op05,op06,op07,op08,op09,op10,op11,op12,op-tcg,romance dawn,paramount war,pillars of strength,kingdoms of intrigue,awakening of the new era,wings of the captain,500 years in the future,two legends

# Blacklist (mots-clés à exclure, séparés par virgules)
BLACKLIST_KEYWORDS=proxy,custom,fake,réplique,damaged,abîmé

# ====== DASHBOARD ======
DASHBOARD_ENABLED=true
DASHBOARD_PORT=3000

# ====== PROXY (optionnel) ======
# PROXY_URL=http://user:pass@host:port
